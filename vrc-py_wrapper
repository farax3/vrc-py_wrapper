#!/usr/bin/bash

HELP() {
  cat <<'EOF'
Usage: vrc-py_wrapper [-v] [-vv|--verbose] [-p|--prune] [ OPERATION [SWITCH] args ]

A CLI for managing and cycling VRChat OSC chat box messages.

r[eplace] [--purge] MESSAGE MESSAGE ...
  Disable (or delete) all enabled message entries with new entries.

d[isable] (a|all) | ENTRY ENTRY ...
  Disable message entries.

de[lete] (a|all) | (disabled|enabled) | ENTRY ENTRY ...
  Delete message entries.

e[nable] (a|all) | ENTRY ENTRY ...
  Enable message entries.

a[ppend] MESSAGE MESSAGE ...
  Append message entries to config.

p[rint] [enabled|disabled]
  Print message entries.

c[lear]
  Wipe config

i[nit]
  Initialize a new config file with example uses.


-p|--purge
  Purge disabled message entries.

-v
  Print message changes to stdout

-vv|--verbose
  Print current timeout and message changes.

h|-h|--help
  Print this message.
EOF
}
CONFIG_PATH="$HOME/.config/vrc-py"
PROFILE_PATH="$CONFIG_PATH/profiles"
CONFIG_FILE="$CONFIG_PATH/messages"
timeout=30
NUMBERED_SUFFIX="${NUMBERED_SUFFIX:=") -"}"
trap 'kill "$PROC_PID" && unset PROC_PID' INT TERM HUP


######   Helpers   ######

parse_fail()
{
  if [ "${2:: 1}" = - ]; then
    printf 'Unrecognised %s: %s\n' "${1}" "${2}"
  else
    printf 'Unrecognised %s: %s\n' "${1}" "${2}"
  fi
  printf "Try: vrc-py_wrapper --help"
  exit 1
}

START_VRC_PY()
{
  coproc PROC { vrc-py; }
  exec {VRCFD}>&"${PROC[1]}"
}

STOP_VRC_PY()
{
  if [ -n "$PROC_PID" ]; then
    kill "$PROC_PID"
    exec {VRCFD}>&-
    unset PROC PROC_PID
    return 0
  fi
  return 1
}

# Sorts entries in ascending order
sort_entries()
{
  sort -nu < <(printf '%s\n' "${@}")
}

# Initialize config path and file
init_config()
{
  # Create a new config if not present
  if [ "$1" = "init" ] || ! [ -e "$CONFIG_FILE" ]; then 
    # Init a new config
    local contents
    contents="$(cat <<'EOF'
message=This is a wrapper.
message="Some quote" - Some Person
message=https://github.com/farax3/vrc-py_wrapper
EOF
)"
  fi
  mkdir -p "$PROFILE_PATH"
  tee <<<"$contents" "$CONFIG_FILE"
}


######   MAIN   ######

# Prints messages from given config
get_messages()
{
  local config="$1"
  sed -e "/^[[:space:]]*#/d;s/^.*=//" "$config"
